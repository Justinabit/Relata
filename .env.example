# ─────────────────────────────────────────────────────────────
# Relata — server environment. Copy to `.env` (never commit it).
# These values are read on the server only and are never sent to
# the browser or bundled into frontend JavaScript.
# ─────────────────────────────────────────────────────────────

# ---- Scholarly sources -------------------------------------
# OpenAlex now meters API usage. A free key (https://openalex.org/settings/api) gives
# a much larger daily budget than the shared keyless one. Strongly recommended.
OPENALEX_API_KEY=
# Optional contact address, sent to Crossref's "polite pool" and shown on the Contact page.
CONTACT_EMAIL=
CROSSREF_MAILTO=

# ---- AI providers ------------------------------------------
# Relata works without AI (verified search only). Add one or both keys to enable
# topic analysis, query expansion and summaries.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Which provider to try first in "Automatic" mode. The other is used as a fallback.
PRIMARY_AI_PROVIDER=gemini
# Model names are configurable because vendors retire models over time.
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4.1-mini

# ---- Server ------------------------------------------------
# The site's public address. Needed for /sitemap.xml, canonical links and share-preview images.
# PUBLIC_URL=https://relata.example
PORT=8787
# Set to true only when running behind a reverse proxy you control (affects rate-limit IPs).
TRUST_PROXY=false
# Who may embed the site in an iframe (CSP frame-ancestors). Default: same origin only.
# FRAME_ANCESTORS='self'

# ---- Limits & retention (all optional) ---------------------
MAX_UPLOAD_MB=8
MAX_EXTRACTED_CHARS=60000
MAX_PDF_PAGES=150
MAX_INPUT_CHARS=20000
AI_MAX_INPUT_CHARS=6000
RATE_LIMIT_SEARCH=40
RATE_LIMIT_AI=20
RATE_LIMIT_UPLOAD=8
# In-memory metadata cache lifetimes (seconds). Uploaded documents are never stored.
SEARCH_CACHE_SECONDS=900
CROSSREF_CACHE_SECONDS=86400
STUDY_STORE_SECONDS=3600
ANALYSIS_CACHE_SECONDS=3600
INSIGHT_CACHE_SECONDS=21600
# Set to false to skip the per-topic OpenAlex count requests (each is a metered search call).
OPENALEX_TOPIC_COUNTS=true
